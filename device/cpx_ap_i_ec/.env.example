# CPX-AP-I-EC I/O configuration.
# Digital counts are points. Analog counts are channels.

CPX_DIGITAL_INPUTS=0
CPX_ANALOG_INPUTS=0
CPX_DIGITAL_OUTPUTS=0
CPX_ANALOG_OUTPUTS=0

# Analog channel width. Supported values: 8, 16, 32.
CPX_ANALOG_BITS=16

# Analog values are encoded as signed little-endian integers when set to 1.
CPX_ANALOG_SIGNED=1
