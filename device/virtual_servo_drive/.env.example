# Virtual servo drive backend settings.
# Copy this file to .env for local mock operation.

# Virtual mock axis type configuration.
# Supported values: linear, rotary. A single value is repeated for all axes.
# Example: MOCK_AXIS_TYPES=linear,linear,rotary
MOCK_AXIS_TYPES=rotary

# Advanced user unit override for 0x216E:01. Empty uses MOCK_AXIS_TYPES.
# Examples: 0x0100=linear m, 0x4100=rotary deg, 0x1000=rotary rad, 0xB400=rotary rev
MOCK_AXIS_USER_UNITS=
