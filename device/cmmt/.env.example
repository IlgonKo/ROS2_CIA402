# CMMT-specific drive profile settings.
# Copy to .env for local CMMT operation.

# CMMT EtherCAT sync setup written via vendor object 0x212E before OP.
# 0=FreeRun, 1=sync with process data, 2=DC Sync0.
# The sync cycle time follows PYSOEM_CYCLE_TIME from .env.
PYSOEM_SYNC_MODE=0

# CMMT PDO configuration used by Motion Server.
# Supported predefined configurations:
#   motion_server_default
#   profile_position_basic
#   csp_basic

# Axis-specific PDO configuration by Motion Server axis index.
# Missing or unknown entries fall back to motion_server_default.
# Entries whose axis index does not exist are ignored.
MOTION_SERVER_CMMT_AXIS_PDO_CONFIGURATIONS=\
    0: motion_server_default,\
    1: motion_server_default,\
    2: motion_server_default

# Optional single-axis override by Motion Server axis index.
# This has priority over MOTION_SERVER_CMMT_AXIS_PDO_CONFIGURATIONS.
# MOTION_SERVER_CMMT_AXIS_0_PDO_CONFIGURATION=profile_position_basic

# Optional physical slave-specific override.
# Axis-specific list/override settings take priority over slave-specific settings.
# MOTION_SERVER_CMMT_SLAVE_0_PDO_CONFIGURATION=motion_server_default

# Final fallback used when no axis-specific setting exists.
MOTION_SERVER_CMMT_PDO_CONFIGURATION=motion_server_default

# Select one code-defined commissioning preset per virtual CMMT slave.
# Supported presets: linear_mm, rotary_deg.
MOTION_SERVER_CMMT_SLAVE_NON_PDO_CONFIGURATIONS=\
    0:linear_mm,1:linear_mm,2:linear_mm,\
    3:rotary_deg,4:rotary_deg,5:rotary_deg
