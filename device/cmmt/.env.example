# CMMT-specific drive profile settings.
# Copy to .env.cmmt for local CMMT operation.

# CMMT EtherCAT sync setup written via vendor object 0x212E before OP.
# 0=FreeRun, 1=sync with process data, 2=DC Sync0.
# The sync cycle time follows PYSOEM_CYCLE_TIME from .env.
PYSOEM_SYNC_MODE=0

# Initial Motion Server motion limits for CMMT axes.
MOTION_SERVER_MAX_VELOCITY=50.0
MOTION_SERVER_ACCELERATION=50.0
MOTION_SERVER_DECELERATION=50.0
MOTION_SERVER_JERK=100000.0
MOTION_SERVER_PP_JERK=100000

# Initial CMMT motion mode.
# pp is recommended for normal non-real-time host operation.
# csp is available for cyclic position streaming tests.
MOTION_SERVER_MOTION_MODE=pp

# CSP scaling and CMMT interpolation mode.
# Example: 1000 count/mm means panel velocity 1000 becomes 1000000 count/s.
MOTION_SERVER_CSP_COUNTS_PER_UNIT=1000.0
MOTION_SERVER_CSP_INTERPOLATION_MODE=1
MOTION_SERVER_CSP_VELOCITY_OFFSET=0

# TxPDO layout selection.
# 0: TxPDO.MAPPING_ENTRIES
# 1: TxPDO.SETPOINT_REPLACE_ENTRIES
PYSOEM_TXPDO_SETPOINT_ENTRY=0
