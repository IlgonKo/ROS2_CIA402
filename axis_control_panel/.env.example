# Axis Control Panel connection defaults.
# The panel can connect to a Motion Server running on another PC.
MOTION_SERVER_HOST=127.0.0.1
MOTION_SERVER_PORT=15000

# Optional display names. Leave empty to use X,Y,Z,U,V,W...
# Axis count is read from the Motion Server system/status API.
AXIS_CONTROL_PANEL_AXIS_NAMES=

# Automatic SDO reads after connect.
# Keep disabled during real EtherCAT operation to avoid delaying PDO cycles.
AXIS_PANEL_AUTO_SDO_READS=0
