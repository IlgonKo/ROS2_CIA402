  {"id":"axis-statusword-lamps","type":"ui-template","z":"tab-axis","group":"axis-status-group","page":"","ui":"","name":"Statusword Lamps","order":1,"width":12,"height":3,"head":"","format":"<template>\n  <div class=\"ms-axis-state\">{{ msg?.payload?.state || 'Not Available' }}</div>\n  <div class=\"ms-lamp-grid\">\n    <div v-for=\"lamp in (msg?.payload?.bits || [])\" :key=\"lamp.bit\" class=\"ms-lamp-item\">\n      <span class=\"ms-lamp\" :class=\"lamp.color\"></span><span>{{ lamp.label }}</span>\n    </div>\n  </div>\n</template>\n<style>\n.ms-axis-state{font-weight:700;font-size:18px;margin:2px 0 12px}.ms-lamp-grid{display:grid;grid-template-columns:repeat(8,minmax(90px,1fr));gap:8px}.ms-lamp-item{display:flex;align-items:center;gap:7px;font-size:12px}.ms-lamp{width:14px;height:14px;border-radius:50%;display:inline-block;background:#3a3a3a;box-shadow:inset 0 0 0 1px #222}.ms-lamp.green{background:#1e8449;box-shadow:0 0 6px #1e8449}.ms-lamp.red{background:#c0392b;box-shadow:0 0 6px #c0392b}.ms-lamp.orange{background:#d68910;box-shadow:0 0 6px #d68910}@media(max-width:800px){.ms-lamp-grid{grid-template-columns:repeat(4,minmax(80px,1fr))}}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1050,"y":260,"wires":[[]]},
  {"id":"axis-enable-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Enable","label":"Enable","order":8,"width":2,"height":1,"emulateClick":false,"tooltip":"Enable selected axis","color":"","bgcolor":"","className":"","icon":"play_arrow","iconPosition":"left","payload":"enable","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":160,"y":290,"wires":[["build-axis-command"]]},
  {"id":"axis-disable-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Disable","label":"Disable","order":9,"width":2,"height":1,"emulateClick":false,"tooltip":"Disable selected axis","color":"","bgcolor":"","className":"","icon":"pause","iconPosition":"left","payload":"disable","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":160,"y":330,"wires":[["build-axis-command"]]},
  {"id":"axis-run-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Run","label":"Run","order":10,"width":2,"height":1,"emulateClick":false,"tooltip":"Move selected axis to target position","color":"","bgcolor":"","className":"","icon":"directions_run","iconPosition":"left","payload":"run","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":150,"y":370,"wires":[["build-axis-command"]]},
  {"id":"axis-stop-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Stop","label":"Stop","order":11,"width":2,"height":1,"emulateClick":false,"tooltip":"Stop selected axis","color":"","bgcolor":"#c0392b","className":"","icon":"stop","iconPosition":"left","payload":"stop","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"#c0392b","textColor":"#ffffff","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":150,"y":410,"wires":[["build-axis-command"]]},
  {"id":"axis-home-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Homing","label":"Homing","order":12,"width":2,"height":1,"emulateClick":false,"tooltip":"Start homing selected axis","color":"","bgcolor":"","className":"","icon":"home","iconPosition":"left","payload":"home","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":160,"y":450,"wires":[["build-axis-command"]]},
  {"id":"axis-reset-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Fault Reset","label":"Fault Reset","order":13,"width":2,"height":1,"emulateClick":false,"tooltip":"Reset selected axis faults","color":"","bgcolor":"","className":"","icon":"restart_alt","iconPosition":"left","payload":"fault_reset","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":170,"y":490,"wires":[["build-axis-command"]]},
  {"id":"axis-refresh-button","type":"ui-button","z":"tab-axis","group":"axis-motion-group","name":"Refresh","label":"Refresh","order":14,"width":2,"height":1,"emulateClick":false,"tooltip":"Read selected axis full status","color":"","bgcolor":"","className":"","icon":"refresh","iconPosition":"left","payload":"refresh","payloadType":"str","topic":"topic","topicType":"msg","buttonColor":"","textColor":"","iconColor":"","enableClick":true,"enablePointerdown":false,"pointerdownPayload":"","pointerdownPayloadType":"str","enablePointerup":false,"pointerupPayload":"","pointerupPayloadType":"str","x":160,"y":530,"wires":[["build-axis-command"]]},
  {"id":"axis-jog-controls","type":"ui-template","z":"tab-axis","group":"axis-jog-group","page":"","ui":"","name":"Jog Controls","order":1,"width":8,"height":2,"head":"","format":"<template>\n  <div class=\"ms-jog-controls\">\n    <v-btn class=\"ms-jog-button\" prepend-icon=\"mdi-arrow-left\"\n      @pointerdown.prevent=\"startJog('jog_negative', $event)\"\n      @pointerup=\"stopJog\" @pointerleave=\"stopJog\" @pointercancel=\"stopJog\">Jog −</v-btn>\n    <div class=\"ms-jog-speed\"><span>Jog Speed</span><strong>slow</strong></div>\n    <v-btn class=\"ms-jog-button\" append-icon=\"mdi-arrow-right\"\n      @pointerdown.prevent=\"startJog('jog_positive', $event)\"\n      @pointerup=\"stopJog\" @pointerleave=\"stopJog\" @pointercancel=\"stopJog\">Jog +</v-btn>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { jogging: false } },\n  methods: {\n    startJog(action, event) {\n      if (event?.currentTarget?.setPointerCapture && event.pointerId !== undefined) event.currentTarget.setPointerCapture(event.pointerId)\n      this.jogging = true\n      this.send({ payload: action })\n    },\n    stopJog() {\n      if (!this.jogging) return\n      this.jogging = false\n      this.send({ payload: 'jog_stop' })\n    }\n  }\n}\n</script>\n<style>\n.ms-jog-controls{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;height:100%}.ms-jog-button{min-height:54px;touch-action:none;user-select:none}.ms-jog-speed{display:flex;flex-direction:column;align-items:center;min-width:90px;font-size:12px}.ms-jog-speed strong{font-size:16px}@media(max-width:600px){.ms-jog-controls{grid-template-columns:1fr 1fr}.ms-jog-speed{grid-column:1 / 3;grid-row:1}}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":false,"templateScope":"local","className":"","x":160,"y":610,"wires":[["build-axis-command"]]},
  {"id":"build-axis-command","type":"function","z":"tab-axis","name":"Build Axis Command","func":"const axis = Number(flow.get('selectedAxis'));\nconst count = Number(flow.get('axisCount'));\nif (!Number.isInteger(axis) || !Number.isInteger(count) || axis < 0 || axis >= count) { node.warn('Select a valid axis'); return null; }\nconst action = String(msg.payload);\nconst commands = { enable: { cmd: 'system/axis/enable', axis }, disable: { cmd: 'system/axis/disable', axis }, stop: { cmd: 'system/axis/stop', axis }, home: { cmd: 'system/axis/home', axis }, fault_reset: { cmd: 'system/axis/fault_reset', axis }, refresh: { cmd: 'system/axis/status', axis }, jog_negative: { cmd: 'system/axis/jog_start', axis, direction: 'negative', speed: 'slow' }, jog_positive: { cmd: 'system/axis/jog_start', axis, direction: 'positive', speed: 'slow' }, jog_stop: { cmd: 'system/axis/jog_stop', axis } };\nif (action === 'run') { const position = Number(flow.get('axisTargetPosition')); const profileVelocity = Number(flow.get('axisProfileVelocity')); if (!Number.isFinite(position) || !Number.isFinite(profileVelocity) || profileVelocity <= 0) { node.warn('Target position and positive profile velocity are required'); return null; } msg.payload = { cmd: 'system/axis/move_abs', axis, position, profile_velocity: profileVelocity }; return msg; }\nif (!commands[action]) { node.warn(`Unknown axis action: ${action}`); return null; }\nmsg.payload = commands[action]; return msg;","outputs":1,"x":430,"y":450,"wires":[["axis-request"]]},
  {"id":"axis-feedback","type":"motion-server-feedback","z":"tab-axis","name":"System Feedback","connection":"cfg-status","x":160,"y":750,"wires":[["axis-feedback-view","axis-position-series","axis-velocity-series","axis-settings-feedback-context"]]},
  {"id":"axis-feedback-view","type":"function","z":"tab-axis","name":"Selected Axis Feedback","func":"const payload = msg.payload || {}; const positions = Array.isArray(payload.actual_positions) ? payload.actual_positions : []; const velocities = Array.isArray(payload.actual_velocities) ? payload.actual_velocities : []; const targets = Array.isArray(payload.target_positions) ? payload.target_positions : []; const statuswords = Array.isArray(payload.statuswords) ? payload.statuswords : []; let count = flow.get('axisCount'); let selector = null; let requestStatus = null;\nif (!Number.isInteger(count)) { count = positions.length; flow.set('axisCount', count); const options = Array.from({ length: count }, (_, index) => ({ value: index, label: `Axis ${index}` })); const selected = count > 0 ? 0 : null; flow.set('selectedAxis', selected); selector = { payload: selected, ui_update: { options } }; if (selected !== null) requestStatus = { payload: { cmd: 'system/axis/status', axis: selected } }; }\nconst axis = Number(flow.get('selectedAxis')); if (!Number.isInteger(axis) || axis < 0 || axis >= count) return [null,null,null,null,selector,requestStatus,null]; const statusword = Number(statuswords[axis] || 0); const labels = ['Ready','Switched','Op En','Fault','Volt En','Quick Stop','SOD','Warning','Moving','Remote','Reached','Limit','OMS 12','OMS 13','Manuf 14','Referenced']; const bits = labels.map((label, bit) => ({ bit, label, color: !(statusword & (1 << bit)) ? 'off' : bit === 3 ? 'red' : bit === 7 ? 'orange' : 'green' })); const masked = statusword & 0x006f; let state = 'State Changed'; if (statusword & 0x0008) state = 'Fault'; else if (masked === 0x0027) state = 'Op Enabled'; else if (masked === 0x0023) state = 'Switched On'; else if (masked === 0x0021) state = 'Ready'; else if (masked === 0x0040) state = 'Switch Disabled'; else if (masked === 0x0000) state = 'Not Ready'; const authority = payload.command_authority || {};\nreturn [{ payload: { axis, statusword, state, bits } }, { payload: positions[axis] ?? 0 }, { payload: velocities[axis] ?? 0 }, { payload: targets[axis] ?? 0 }, selector, requestStatus, { topic: 'axis/parameter-context', payload: { axis, authority_owned: authority.owned_by_this_client === true } }];","outputs":7,"x":440,"y":750,"wires":[["axis-statusword-lamps","axis-statusword-format"],["axis-actual-position"],["axis-actual-velocity"],["axis-active-target"],["axis-selector"],["axis-request"],["axis-parameter-panel"]]},
  {"id":"axis-statusword-format","type":"function","z":"tab-axis","name":"Format Statusword","func":"const value = Number(msg.payload?.statusword || 0); return { payload: `0x${value.toString(16).toUpperCase().padStart(4, '0')}` };","outputs":1,"x":760,"y":260,"wires":[["axis-statusword-value"]]},
