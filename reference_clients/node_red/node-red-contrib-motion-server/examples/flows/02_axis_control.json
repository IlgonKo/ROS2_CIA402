  {"id":"axis-settings-panel","type":"ui-template","z":"tab-axis","group":"axis-settings-group","page":"","ui":"","name":"Axis Motion Settings","order":1,"width":12,"height":8,"head":"","format":"<template>\n  <div class=\"ms-axis-settings\">\n    <div class=\"ms-settings-header\"><strong>Axis {{ axis === null ? '-' : axis }}</strong><span>Mode: {{ motionMode || '-' }}</span><span>Authority: {{ authorityOwned ? 'owned by this client' : 'required to apply' }}</span><button @click=\"refresh\" :disabled=\"axis===null\">Refresh</button></div>\n    <fieldset><legend>Profile Parameters</legend><div class=\"ms-settings-row\"><label>Velocity ({{ velocityUnit }}) <input type=\"number\" v-model.number=\"profile.velocity\" :disabled=\"isPv\"></label><label>Acceleration ({{ accelerationUnit }}) <input type=\"number\" v-model.number=\"profile.acceleration\"></label><label>Deceleration ({{ decelerationUnit }}) <input type=\"number\" v-model.number=\"profile.deceleration\"></label><label>Jerk ({{ jerkUnit }}) <input type=\"number\" v-model.number=\"profile.jerk\" :disabled=\"isPv\"></label><button @click=\"applyProfile\" :disabled=\"!canApply\">Apply Profile</button></div><div v-if=\"isPv\" class=\"ms-settings-note\">PV mode uses acceleration and deceleration only.</div></fieldset>\n    <fieldset><legend>Motion Limits</legend><div class=\"ms-settings-row\"><label>Positive Velocity ({{ velocityUnit }}) <input type=\"number\" v-model.number=\"limits.positiveVelocity\"></label><label>Negative Velocity ({{ velocityUnit }}) <input type=\"number\" v-model.number=\"limits.negativeVelocity\"></label><label>Max Acceleration ({{ accelerationUnit }}) <input type=\"number\" v-model.number=\"limits.acceleration\"></label><label>Max Deceleration ({{ decelerationUnit }}) <input type=\"number\" v-model.number=\"limits.deceleration\"></label><button @click=\"applyMotionLimits\" :disabled=\"!canApply\">Apply Motion Limits</button></div></fieldset>\n    <fieldset><legend>Software Position Limits</legend><div class=\"ms-settings-row\"><label>Negative Limit ({{ positionUnit }}) <input type=\"number\" v-model.number=\"softLimits.negative\"></label><label>Positive Limit ({{ positionUnit }}) <input type=\"number\" v-model.number=\"softLimits.positive\"></label><button @click=\"applySoftLimits\" :disabled=\"!canApply\">Apply SW Limits</button></div></fieldset>\n    <div class=\"ms-settings-result\" :class=\"{failed}\">{{ result }}</div>\n  </div>\n</template>\n<script>\nexport default {\n  data(){return{axis:null,authorityOwned:false,motionMode:'',metadata:{},profile:{velocity:0,acceleration:0,deceleration:0,jerk:0},limits:{positiveVelocity:0,negativeVelocity:0,acceleration:0,deceleration:0},softLimits:{negative:0,positive:0},result:'Select an axis and refresh status.',failed:false}},\n  computed:{isPv(){return this.motionMode==='pv'},canApply(){return this.axis!==null&&this.authorityOwned},positionUnit(){return this.metadata.position_unit||'unit'},velocityUnit(){return this.metadata.velocity_unit||`${this.positionUnit}/s`},accelerationUnit(){return this.metadata.acceleration_unit||`${this.positionUnit}/s²`},decelerationUnit(){return this.metadata.deceleration_unit||this.accelerationUnit},jerkUnit(){return this.metadata.jerk_unit||`${this.positionUnit}/s³`}},\n  watch:{msg:{deep:true,immediate:true,handler(message){if(!message||!message.topic)return;const value=message.payload||{};if(message.topic==='axis/settings-context'){if(value.axis!==undefined)this.axis=Number.isInteger(Number(value.axis))?Number(value.axis):null;if(value.authority_owned!==undefined)this.authorityOwned=value.authority_owned===true}else if(message.topic==='axis/settings-status')this.loadStatus(value);else if(message.topic==='axis/settings-response')this.handleResponse(value);else if(message.topic==='axis/settings-clear'){this.axis=null;this.authorityOwned=false;this.motionMode='';this.result='NOT CONNECTED';this.failed=true}}}},\n  methods:{\n    finite(values){return values.every(value=>Number.isFinite(Number(value)))},sendRequest(payload){if(this.axis===null)return;this.send({axis:this.axis,payload:{...payload,axis:this.axis}})},refresh(){this.sendRequest({cmd:'system/axis/status'})},\n    applyProfile(){const values=[this.profile.acceleration,this.profile.deceleration];if(!this.isPv)values.push(this.profile.velocity,this.profile.jerk);if(!this.finite(values)){this.localFail('Profile values must be numeric.');return}const payload={cmd:'system/axis/profile',profile_acceleration:Number(this.profile.acceleration),profile_deceleration:Number(this.profile.deceleration)};if(!this.isPv){payload.profile_velocity=Number(this.profile.velocity);payload.profile_jerk=Number(this.profile.jerk)}this.sendRequest(payload)},\n    applyMotionLimits(){const values=Object.values(this.limits);if(!this.finite(values)){this.localFail('Motion limit values must be numeric.');return}this.sendRequest({cmd:'system/axis/motion_limits',positive_velocity_limit:Number(this.limits.positiveVelocity),negative_velocity_limit:Number(this.limits.negativeVelocity),max_acceleration:Number(this.limits.acceleration),max_deceleration:Number(this.limits.deceleration)})},\n    applySoftLimits(){const negative=Number(this.softLimits.negative);const positive=Number(this.softLimits.positive);if(!this.finite([negative,positive])){this.localFail('Software limits must be numeric.');return}if(negative>positive){this.localFail('Negative software limit must not exceed positive limit.');return}this.sendRequest({cmd:'system/axis/software_position_limits',negative_limit:negative,positive_limit:positive})},\n    localFail(message){this.result=message;this.failed=true},loadStatus(data){if(Number.isInteger(Number(data.axis)))this.axis=Number(data.axis);this.motionMode=String(data.motion_mode||'');this.metadata=data.axis_metadata||{};const profile=Array.isArray(data.profile_settings)?data.profile_settings:[];const limits=Array.isArray(data.motion_limits)?data.motion_limits:[];const soft=Array.isArray(data.software_position_limits)?data.software_position_limits:[];if(profile.length>=4)this.profile={velocity:Number(profile[0]),acceleration:Number(profile[1]),deceleration:Number(profile[2]),jerk:Number(profile[3])};if(limits.length>=4)this.limits={positiveVelocity:Number(limits[0]),negativeVelocity:Number(limits[1]),acceleration:Number(limits[2]),deceleration:Number(limits[3])};if(soft.length>=2)this.softLimits={negative:Number(soft[0]),positive:Number(soft[1])};const authority=data.command_authority||{};this.authorityOwned=authority.owned_by_this_client===true;this.result='Settings refreshed from device readback.';this.failed=false},\n    handleResponse(response){if(response.result==='success'){this.result=`${response.type}: SUCCESS · refreshing readback`;this.failed=false;return}const failure=response.failure||{};this.result=`FAIL: ${failure.code||failure.message||'UNKNOWN'}${failure.message?` · ${failure.message}`:''}`;this.failed=true}\n  }\n}\n</script>\n<style>\n.ms-axis-settings{font-family:Arial,sans-serif}.ms-settings-header,.ms-settings-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.ms-settings-header{margin-bottom:8px}.ms-settings-header strong{font-size:18px;margin-right:8px}.ms-axis-settings fieldset{border:1px solid #ccc;padding:10px;margin:8px 0}.ms-axis-settings legend{padding:0 5px}.ms-settings-row label{display:flex;align-items:center;gap:5px;white-space:nowrap}.ms-axis-settings input{width:115px;border:1px solid #bbb;background:#fff;padding:5px}.ms-axis-settings button{border:1px solid #aaa;border-radius:4px;background:#fff;padding:6px 10px;cursor:pointer}.ms-axis-settings button:disabled{color:#999;background:#eee;cursor:default}.ms-settings-note{margin-top:7px;color:#555}.ms-settings-result{margin-top:8px;color:#176d29}.ms-settings-result.failed{color:#b3261e}@media(max-width:900px){.ms-settings-row label{flex:1 1 42%}}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1050,"y":560,"wires":[["axis-settings-request"]]},
  {"id":"axis-settings-request","type":"motion-server-request","z":"tab-axis","name":"Axis Settings API","connection":"cfg-status","timeout":"","x":760,"y":560,"wires":[["format-axis-settings-response","axis-settings-debug"],["format-axis-settings-error","axis-settings-error-debug"]]},
  {"id":"format-axis-settings-response","type":"function","z":"tab-axis","name":"Format Axis Settings Response","func":"const response=msg.payload||{};const panel={topic:'axis/settings-response',payload:response};const refresh=response.result==='success'?{payload:{cmd:'system/axis/status',axis:Number(msg.axis)}}:null;return [panel,refresh];","outputs":2,"x":760,"y":610,"wires":[["axis-settings-panel"],["axis-request"]]},
  {"id":"format-axis-settings-error","type":"function","z":"tab-axis","name":"Format Axis Settings Error","func":"const error=msg.payload||{};return {topic:'axis/settings-response',payload:{result:'fail',failure:{code:error.code||'CLIENT_ERROR',message:error.message||'Client transport failure'}}};","outputs":1,"x":760,"y":660,"wires":[["axis-settings-panel"]]},
  {"id":"axis-settings-status","type":"function","z":"tab-axis","name":"Axis Status to Settings","func":"const response=msg.payload||{};if(response.result!=='success'||response.type!=='system/axis/status')return null;const data={...(response.data||{})};const round2=value=>{const number=Number(value);return Number.isFinite(number)?Math.sign(number)*Math.round((Math.abs(number)+Number.EPSILON)*100)/100:value;};for(const field of ['profile_settings','motion_limits','software_position_limits'])if(Array.isArray(data[field]))data[field]=data[field].map(round2);return {topic:'axis/settings-status',payload:data};","outputs":1,"x":950,"y":380,"wires":[["axis-settings-panel"]]},
  {"id":"axis-settings-feedback-context","type":"function","z":"tab-axis","name":"Settings Authority Context","func":"const axis=Number(flow.get('selectedAxis'));if(!Number.isInteger(axis))return null;const authority=msg.payload?.command_authority||{};return {topic:'axis/settings-context',payload:{axis,authority_owned:authority.owned_by_this_client===true}};","outputs":1,"x":470,"y":700,"wires":[["axis-settings-panel"]]},
  {"id":"axis-settings-connection","type":"function","z":"tab-axis","name":"Clear Settings on Disconnect","func":"if(msg.payload?.connected)return null;return {topic:'axis/settings-clear',payload:{}};","outputs":1,"x":450,"y":860,"wires":[["axis-settings-panel"]]},
  {"id":"axis-settings-debug","type":"debug","z":"tab-axis","name":"Axis Settings Success or Fail","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":1060,"y":610,"wires":[]},
  {"id":"axis-settings-error-debug","type":"debug","z":"tab-axis","name":"Axis Settings Client Error","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":1050,"y":660,"wires":[]},
  {"id":"axis-selector","type":"ui-dropdown","z":"tab-axis","group":"axis-motion-group","name":"Axis Selector","label":"Selected Axis","tooltip":"Select an axis reported by the first feedback","order":1,"width":4,"height":1,"passthru":false,"multiple":false,"chips":false,"clearable":false,"options":[{"value":0,"label":"Axis 0","type":"num"}],"payload":"","topic":"topic","topicType":"msg","className":"","typeIsComboBox":false,"msgTrigger":"onChange","x":160,"y":80,"wires":[["store-selected-axis"]]},
  {"id":"store-selected-axis","type":"function","z":"tab-axis","name":"Select Axis","func":"const axis = Number(msg.payload);\nconst count = Number(flow.get('axisCount'));\nif (!Number.isInteger(axis) || !Number.isInteger(count) || axis < 0 || axis >= count) {\n    node.warn(`Axis index must be in 0..${Math.max(0, count - 1)}`);\n    return null;\n}\nflow.set('selectedAxis', axis);\nreturn [{ payload: { cmd: 'system/axis/status', axis } }, { payload: [] }, { topic: 'axis/parameter-context', payload: { axis } }];","outputs":3,"x":410,"y":80,"wires":[["axis-request"],["axis-position-chart","axis-velocity-chart"],["axis-parameter-panel"]]},
  {"id":"axis-target-input","type":"ui-text-input","z":"tab-axis","group":"axis-motion-group","name":"Target Position Input","label":"Target Position","order":2,"width":4,"height":1,"topic":"topic","topicType":"msg","mode":"number","tooltip":"Absolute target in the selected axis API unit","delay":300,"passthru":false,"sendOnDelay":false,"sendOnBlur":true,"sendOnEnter":true,"className":"","clearable":false,"sendOnClear":false,"icon":"","iconPosition":"left","iconInnerPosition":"inside","x":170,"y":130,"wires":[["store-target-position"]]},
  {"id":"axis-speed-input","type":"ui-text-input","z":"tab-axis","group":"axis-motion-group","name":"Profile Velocity Input","label":"Profile Velocity","order":3,"width":4,"height":1,"topic":"topic","topicType":"msg","mode":"number","tooltip":"Positive profile velocity in the selected axis API unit/s","delay":300,"passthru":false,"sendOnDelay":false,"sendOnBlur":true,"sendOnEnter":true,"className":"","clearable":false,"sendOnClear":false,"icon":"","iconPosition":"left","iconInnerPosition":"inside","x":170,"y":180,"wires":[["store-profile-velocity"]]},
  {"id":"store-target-position","type":"function","z":"tab-axis","name":"Store Target Position","func":"const value = Number(msg.payload);\nif (!Number.isFinite(value)) { node.warn('Target position must be numeric'); return null; }\nflow.set('axisTargetPosition', value);\nreturn null;","outputs":1,"x":450,"y":130,"wires":[[]]},
  {"id":"store-profile-velocity","type":"function","z":"tab-axis","name":"Store Profile Velocity","func":"const value = Number(msg.payload);\nif (!Number.isFinite(value) || value <= 0) { node.warn('Profile velocity must be greater than 0'); return null; }\nflow.set('axisProfileVelocity', value);\nreturn null;","outputs":1,"x":450,"y":180,"wires":[[]]},
