  {"id":"axis-command-result","type":"ui-text","z":"tab-axis","group":"axis-motion-group","name":"Command Result","label":"Command Result","order":15,"width":8,"height":1,"format":"{{msg.payload}}","layout":"row-spread","style":false,"font":"Helvetica","fontSize":14,"color":"#717171","wrapText":true,"className":"","value":"payload","valueType":"msg","x":1190,"y":450,"wires":[]},
  {"id":"axis-parameter-panel","type":"ui-template","z":"tab-axis","group":"axis-parameter-group","page":"","ui":"","name":"Axis Parameter Access","order":1,"width":12,"height":4,"head":"","format":"<template>\n  <div class=\"ms-axis-param\">\n    <div class=\"ms-axis-param-row\"><strong>Axis {{ axis === null ? '-' : axis }} SDO</strong><label>Catalog <select v-model=\"catalogIndex\" @change=\"applyCatalog\"><option value=\"\">manual</option><option v-for=\"(item,index) in catalog\" :key=\"index\" :value=\"index\">{{ item.label }}</option></select></label><button @click=\"loadCatalog\" :disabled=\"axis===null\">Load Catalog</button></div>\n    <div class=\"ms-axis-param-detail\">{{ catalogDetail }}</div>\n    <div class=\"ms-axis-param-row\"><label>Index <input v-model=\"index\"></label><label>Subindex <input v-model=\"subindex\"></label><label>Type <select v-model=\"dataType\"><option v-for=\"type in dataTypes\" :key=\"type\">{{ type }}</option></select></label><label>Length <input v-model=\"length\"></label><label>Value <input v-model=\"value\"></label><button @click=\"readParameter\" :disabled=\"axis===null\">Read</button><button @click=\"writeParameter\" :disabled=\"axis===null||!authorityOwned\">Write</button><button @click=\"saveParameters\" :disabled=\"axis===null||!authorityOwned\">Parameter Save</button></div>\n    <div class=\"ms-axis-param-result\" :class=\"{failed}\">{{ result }}</div>\n  </div>\n</template>\n<script>\nexport default {\n  data(){return{axis:null,authorityOwned:false,index:'0x607F',subindex:'0x00',dataType:'uint32',length:'',value:'0',dataTypes:['uint8','int8','uint16','int16','int32','uint32','udint','float32','string'],catalog:[],catalogIndex:'',catalogDetail:'',result:'No SDO request yet.',failed:false}},\n  watch:{msg:{deep:true,immediate:true,handler(message){if(!message||!message.topic)return;const payload=message.payload||{};if(message.topic==='axis/parameter-context'){this.axis=Number.isInteger(Number(payload.axis))?Number(payload.axis):null;if(payload.authority_owned!==undefined)this.authorityOwned=payload.authority_owned===true}else if(message.topic==='axis/parameter-response')this.handleResponse(payload)}}},\n  methods:{\n    request(payload){if(this.axis===null)return;this.send({payload:{...payload,axis:this.axis}})}, optional(payload){if(String(this.length||'').trim()!=='')payload.length=this.length;return payload},\n    loadCatalog(){this.request({cmd:'system/axis/param_catalog'})}, readParameter(){this.request(this.optional({cmd:'system/axis/param_read',index:this.index,subindex:this.subindex,data_type:this.dataType}))}, writeParameter(){this.request(this.optional({cmd:'system/axis/param_write',index:this.index,subindex:this.subindex,data_type:this.dataType,value:this.value}))}, saveParameters(){this.request({cmd:'system/axis/param_save'})},\n    catalogType(value,bits){const text=String(value||'').trim().toLowerCase();const size=Number(bits||0);if(text.startsWith('string(')||text.includes('string')||text==='char')return 'string';if(['bool','booleant','boolean','byte','uint8','usint'].includes(text))return 'uint8';if(['integer8','int8','sint'].includes(text))return 'int8';if(['uint16','uint','uint16t','uintegert'].includes(text))return 'uint16';if(['int16','integer16'].includes(text))return 'int16';if(['uint32','udint','uint32t'].includes(text))return 'uint32';if(['int32','dint','integer32'].includes(text))return 'int32';if(['float32','real'].includes(text))return 'float32';if(text.includes('unsigned'))return size<=8?'uint8':size<=16?'uint16':'uint32';if(text.includes('integer')||text.includes('signed'))return size<=8?'int8':size<=16?'int16':'int32';return 'uint32'},\n    buildCatalog(data){const entries=[];for(const object of data.objects||[]){const subs=object.subitems||[];if(subs.length){for(const sub of subs)entries.push({label:`${object.index_hex||object.index}:${sub.subindex_hex||sub.subindex} ${sub.name||object.name||''}`,index:object.index_hex||object.index,subindex:sub.subindex_hex||sub.subindex,dataType:this.catalogType(sub.data_type,sub.bit_size),length:Number(sub.bit_size||0)/8||'',detail:`${object.name||''}.${sub.name||''} type=${sub.data_type||''} access=${sub.access||''}`})}else entries.push({label:`${object.index_hex||object.index}:${object.subindex_hex||'0x00'} ${object.name||''}`,index:object.index_hex||object.index,subindex:object.subindex_hex||'0x00',dataType:this.catalogType(object.data_type,object.bit_size),length:Number(object.bit_size||0)/8||'',detail:`${object.name||''} type=${object.data_type||''} access=${object.access||''}`})}this.catalog=entries;this.catalogIndex=entries.length?'0':'';this.applyCatalog()},\n    applyCatalog(){const item=this.catalog[Number(this.catalogIndex)];if(!item){this.catalogDetail='';return}this.index=item.index;this.subindex=item.subindex;this.dataType=item.dataType;this.length=item.dataType==='string'?item.length:'';this.catalogDetail=item.detail},\n    handleResponse(response){if(response.result!=='success'){const failure=response.failure||{};this.result=`FAIL: ${failure.code||failure.message||'UNKNOWN'}`;this.failed=true;return}const data=response.data||{};this.failed=false;if(response.type==='system/axis/param_catalog'){this.buildCatalog(data);this.result=`Catalog loaded: ${this.catalog.length} items`;return}if(response.type==='system/axis/param_read'&&data.value!==undefined)this.value=typeof data.value==='object'?JSON.stringify(data.value):String(data.value);const value=data.value!==undefined?` Value=${typeof data.value==='object'?JSON.stringify(data.value):data.value}`:'';const hex=data.hex?` (${data.hex})`:'';this.result=`${response.type}: SUCCESS${value}${hex}`}\n  }\n}\n</script>\n<style>\n.ms-axis-param{font-family:Arial,sans-serif}.ms-axis-param-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.ms-axis-param-row label{display:flex;align-items:center;gap:4px;white-space:nowrap}.ms-axis-param input,.ms-axis-param select{border:1px solid #bbb;background:#fff;padding:5px;max-width:190px}.ms-axis-param button{border:1px solid #aaa;border-radius:4px;background:#fff;padding:6px 10px;cursor:pointer}.ms-axis-param button:disabled{color:#999;background:#eee;cursor:default}.ms-axis-param-detail{min-height:20px;margin:7px 0;color:#555}.ms-axis-param-result{margin-top:8px;color:#176d29}.ms-axis-param-result.failed{color:#b3261e}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1030,"y":650,"wires":[["axis-parameter-request"]]},
