  {"id":"axis-response-view","type":"function","z":"tab-axis","name":"Process Axis Response","func":"const response = msg.payload || {}; if (response.result !== 'success') { const failure = response.failure || {}; return [{ payload: `FAIL: ${failure.code || failure.message || 'UNKNOWN'}` }, null, null]; } const data = response.data || {}; if (response.type !== 'system/axis/status') return [{ payload: `${response.type}: SUCCESS` }, null, null]; const target = Number(data.target_position); const profile = Array.isArray(data.profile_settings) ? Number(data.profile_settings[0]) : NaN; if (Number.isFinite(target)) flow.set('axisTargetPosition', target); if (Number.isFinite(profile) && profile > 0) flow.set('axisProfileVelocity', profile); return [{ payload: 'STATUS REFRESHED' }, Number.isFinite(target) ? { payload: target } : null, Number.isFinite(profile) && profile > 0 ? { payload: profile } : null];","outputs":3,"x":950,"y":430,"wires":[["axis-command-result"],["axis-target-input"],["axis-speed-input"]]},
