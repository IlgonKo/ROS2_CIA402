  {"id":"dashboard-ui","type":"ui-base","name":"Motion Server Dashboard","path":"/dashboard","appIcon":"","includeClientData":true,"acceptsClientConfig":["ui-notification","ui-control"],"showPathInSidebar":false,"headerContent":"page","navigationStyle":"default","titleBarStyle":"default","showReconnectNotification":true,"notificationDisplayTime":1,"showDisconnectNotification":true,"allowInstall":false},
  {"id":"dashboard-theme","type":"ui-theme","name":"Motion Server Default Theme","colors":{"surface":"#ffffff","primary":"#0094CE","bgPage":"#eeeeee","groupBg":"#ffffff","groupOutline":"#cccccc"},"sizes":{"density":"compact","pagePadding":"8px","groupGap":"8px","groupBorderRadius":"2px","widgetGap":"6px"}},
  {"id":"server-page","type":"ui-page","name":"Server Control","ui":"dashboard-ui","path":"/server","icon":"settings_ethernet","layout":"grid","theme":"dashboard-theme","breakpoints":[{"name":"Default","px":0,"cols":3},{"name":"Tablet","px":576,"cols":6},{"name":"Small Desktop","px":768,"cols":9},{"name":"Desktop","px":1024,"cols":12}],"order":1,"className":"","visible":"true","disabled":"false"},
  {"id":"server-control-group","type":"ui-group","name":"Motion Server Control","page":"server-page","width":12,"height":1,"order":1,"showTitle":false,"className":"ms-server-control-group","visible":true,"disabled":false,"groupType":"default"},
  {"id":"server-control-panel","type":"ui-template","z":"tab-common","group":"server-control-group","page":"","ui":"","name":"Motion Server Control Bar","order":1,"width":12,"height":3,"head":"","format":"<template>\n  <div class=\"ms-server-panel\">\n    <div class=\"ms-server-toolbar\">\n      <strong class=\"ms-server-title\">Motion Server</strong>\n      <button @click=\"command('authority_toggle')\" :disabled=\"!connected\">{{ authorityOwned ? 'Release Authority' : 'Request Authority' }}</button>\n      <button @click=\"command('bus_reconnect')\" :disabled=\"!connected\">Bus Reconnect</button>\n      <button @click=\"command('server_fault_reset')\" :disabled=\"!connected\">Server Fault Reset</button>\n      <button @click=\"command('server_restart')\" :disabled=\"!connected\">Server Restart</button>\n      <span class=\"ms-inline-status\">Authority: {{ authorityText }}</span>\n      <label>Host <input v-model.trim=\"host\" :disabled=\"connected\" @change=\"endpointChanged\"></label>\n      <label>Port <input class=\"ms-port\" v-model.number=\"port\" type=\"number\" min=\"1\" max=\"65535\" :disabled=\"connected\" @change=\"endpointChanged\"></label>\n      <button class=\"ms-connect-button\" :class=\"{connected}\" @click=\"toggleConnection\">{{ connected ? 'Disconnect' : 'Connect' }}</button>\n      <span class=\"ms-inline-status\">{{ connectionText }}</span>\n    </div>\n    <fieldset class=\"ms-server-status\">\n      <legend>Motion Server Status</legend>\n      <div>{{ serverStatusText }}</div>\n      <div v-if=\"lastOperation\" class=\"ms-operation\" :class=\"{failed:lastOperationFailed}\">{{ lastOperation }}</div>\n    </fieldset>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { host: '127.0.0.1', port: 15000, connected: false, lastError: '', authorityOwned: false, authorityAvailable: false, authorityOwner: null, serverHealth: null, processDataValid: false, lastOperation: '', lastOperationFailed: false } },\n  computed: {\n    authorityText() { if (!this.connected) return 'not available'; if (this.authorityOwned) return 'owned by this client'; if (this.authorityAvailable) return 'available'; return this.authorityOwner == null ? 'unavailable' : `owned by client ${this.authorityOwner}` },\n    connectionText() { if (this.connected) return `Connected ${this.host}:${this.port}`; return this.lastError ? `Disconnected: ${this.lastError}` : 'Disconnected' },\n    serverStatusText() { const h = this.serverHealth; if (!h) return 'Server: unavailable'; const initialized = h.initialized ? 'yes' : 'no'; const level = h.diagnostic_level || 'normal'; const valid = this.processDataValid ? 'process data valid' : 'process data invalid'; return `Server: ${h.runtime_state || 'unknown'} | initialized ${initialized} | ${level} (faults ${h.fault_count || 0}, alarms ${h.alarm_count || 0}) | ${valid}` }\n  },\n  watch: {\n    msg: { deep: true, immediate: true, handler(message) { if (!message || !message.topic) return; const value = message.payload || {}; if (message.topic === 'dashboard/endpoint') { this.host = value.host || this.host; this.port = Number(value.port || this.port) } else if (message.topic === 'dashboard/connection') { this.connected = value.connected === true; this.lastError = value.last_error || ''; if (!this.connected) { this.authorityOwned = false; this.authorityAvailable = false; this.authorityOwner = null; this.serverHealth = null; this.processDataValid = false } } else if (message.topic === 'dashboard/feedback') { const authority = value.command_authority || {}; this.authorityOwned = authority.owned_by_this_client === true; this.authorityAvailable = authority.available === true; this.authorityOwner = authority.owner; this.serverHealth = value.server_health || null; this.processDataValid = value.process_data_valid === true } else if (message.topic === 'dashboard/operation') { this.lastOperation = value.text || ''; this.lastOperationFailed = value.failed === true } } }\n  },\n  methods: {\n    command(action) { this.send({ payload: { action } }) },\n    endpointChanged() { this.send({ payload: { action: 'endpoint', host: this.host, port: Number(this.port) } }) },\n    toggleConnection() { this.send({ payload: { action: this.connected ? 'disconnect' : 'connect', host: this.host, port: Number(this.port) } }) }\n  }\n}\n</script>\n<style>\n.ms-server-panel{font-family:Arial,sans-serif;color:#222}.ms-server-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:2px}.ms-server-title{font-size:20px;margin-right:8px}.ms-server-toolbar button{border:1px solid #aaa;border-radius:4px;background:#fff;padding:6px 10px;white-space:nowrap;cursor:pointer}.ms-server-toolbar button:disabled{color:#999;background:#eee;cursor:default}.ms-server-toolbar label{display:flex;align-items:center;gap:5px;white-space:nowrap}.ms-server-toolbar input{width:150px;border:1px solid #bbb;padding:5px 7px;background:#fff}.ms-server-toolbar input.ms-port{width:76px}.ms-connect-button.connected{border-color:#27843a;color:#176d29}.ms-inline-status{white-space:nowrap}.ms-server-status{margin-top:10px;border:1px solid #ccc;padding:8px 10px;min-width:0}.ms-server-status legend{padding:0 5px}.ms-operation{margin-top:6px;color:#176d29}.ms-operation.failed{color:#b3261e}@media(max-width:900px){.ms-server-toolbar{align-items:stretch}.ms-server-toolbar>*{flex:1 1 auto}.ms-server-title{flex-basis:100%}.ms-server-toolbar label{justify-content:space-between}.ms-server-toolbar input{width:100%}}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":1040,"y":280,"wires":[["route-control-action"]]},
  {"id":"route-control-action","type":"function","z":"tab-common","name":"Route Control Action","func":"const value = msg.payload || {};\nconst action = String(value.action || '');\nif (action === 'connect') {\n    const host = String(value.host || '127.0.0.1').trim();\n    const port = Number(value.port || 15000);\n    if (!host || !Number.isInteger(port) || port < 1 || port > 65535) { node.warn('Valid host and port are required'); return null; }\n    return [{ payload: { action: 'connect', host, port } }, null];\n}\nif (action === 'disconnect') return [{ payload: { action: 'disconnect' } }, null];\nif (action === 'endpoint') return null;\nconst commands = { authority_toggle: { cmd: flow.get('authorityOwned') ? 'system/authority/release' : 'system/authority/request' }, bus_reconnect: { cmd: 'system/bus/reconnect' }, server_fault_reset: { cmd: 'system/server/fault_reset' }, server_restart: { cmd: 'system/server/restart' } };\nif (!commands[action]) { node.warn(`Unknown server control action: ${action}`); return null; }\nreturn [null, { payload: commands[action] }];","outputs":2,"x":290,"y":240,"wires":[["connection-control"],["management-request"]]},
  {"id":"connection-control","type":"motion-server-connection-control","z":"tab-common","name":"Connection Control","connection":"cfg-status","x":570,"y":180,"wires":[["format-endpoint"]]},
  {"id":"format-endpoint","type":"function","z":"tab-common","name":"Format Endpoint","func":"return { topic: 'dashboard/endpoint', payload: msg.payload || {} };","outputs":1,"x":810,"y":180,"wires":[["server-control-panel"]]},
  {"id":"connection-status","type":"motion-server-connection-status","z":"tab-common","name":"Connection Status","connection":"cfg-status","x":280,"y":320,"wires":[["format-connection-status","debug-connection"]]},
  {"id":"format-connection-status","type":"function","z":"tab-common","name":"Format Connection Status","func":"const status = msg.payload || {};\nflow.set('motionServerConnected', status.connected === true);\nif (!status.connected) flow.set('authorityOwned', false);\nreturn { topic: 'dashboard/connection', payload: { connected: status.connected === true, last_error: status.last_error || '' } };","outputs":1,"x":570,"y":320,"wires":[["server-control-panel"]]},
  {"id":"feedback-status","type":"motion-server-feedback","z":"tab-common","name":"System Feedback","connection":"cfg-status","x":280,"y":390,"wires":[["format-feedback-status","debug-feedback"]]},
  {"id":"format-feedback-status","type":"function","z":"tab-common","name":"Format Feedback Status","func":"const feedback = msg.payload || {};\nconst authority = feedback.command_authority || {};\nflow.set('authorityOwned', authority.owned_by_this_client === true);\nreturn [[\n  { topic: 'dashboard/feedback', payload: { command_authority: authority, server_health: feedback.server_health || null, process_data_valid: feedback.process_data_valid === true } },\n  { topic: 'dashboard/connection', payload: { connected: true, last_error: '' } }\n]];","outputs":1,"x":570,"y":390,"wires":[["server-control-panel"]]},
  {"id":"management-request","type":"motion-server-request","z":"tab-common","name":"Server Management API","connection":"cfg-status","timeout":"15","x":570,"y":250,"wires":[["format-management-response","debug-management-response"],["format-management-error","debug-client-error"]]},
  {"id":"format-management-response","type":"function","z":"tab-common","name":"Format Management Response","func":"const response = msg.payload || {};\nconst failed = response.result !== 'success';\nconst failure = response.failure || {};\nconst text = failed ? `${response.type || 'COMMAND'}: FAIL ${failure.code || failure.message || 'UNKNOWN'}` : `${response.type || 'COMMAND'}: SUCCESS`;\nreturn { topic: 'dashboard/operation', payload: { text, failed } };","outputs":1,"x":850,"y":230,"wires":[["server-control-panel"]]},
  {"id":"format-management-error","type":"function","z":"tab-common","name":"Format Management Error","func":"const error = msg.payload || {};\nreturn { topic: 'dashboard/operation', payload: { text: `CLIENT ERROR: ${error.code || error.message || 'UNKNOWN'}`, failed: true } };","outputs":1,"x":840,"y":330,"wires":[["server-control-panel"]]},
  {"id":"inject-server","type":"inject","z":"tab-common","name":"Server Status","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/server/status\"}","payloadType":"json","once":false,"x":260,"y":500,"wires":[["request-status"]]},
  {"id":"inject-axes","type":"inject","z":"tab-common","name":"Axes Status","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axes/status\"}","payloadType":"json","once":false,"x":260,"y":550,"wires":[["request-status"]]},
  {"id":"inject-io","type":"inject","z":"tab-common","name":"I/O Status","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/io/status\"}","payloadType":"json","once":false,"x":250,"y":600,"wires":[["request-status"]]},
  {"id":"request-status","type":"motion-server-request","z":"tab-common","name":"Read Status","connection":"cfg-status","timeout":"","x":510,"y":550,"wires":[["debug-response"],["debug-client-error"]]},
  {"id":"debug-connection","type":"debug","z":"tab-common","name":"Connection","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":550,"y":450,"wires":[]},
