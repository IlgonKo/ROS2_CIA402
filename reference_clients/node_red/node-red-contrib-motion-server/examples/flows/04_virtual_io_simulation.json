[
  {"id":"tab-simulation","type":"tab","label":"04 Virtual I/O Simulation","disabled":false,"info":"Dashboard for Mock-only Virtual CPX input simulation. Enable MOTION_SERVER_SIMULATION_API_ENABLED first."},
  {"id":"simulation-page","type":"ui-page","name":"Virtual I/O Simulation","ui":"dashboard-ui","path":"/virtual-io","icon":"science","layout":"grid","theme":"dashboard-theme","breakpoints":[{"name":"Default","px":0,"cols":3},{"name":"Tablet","px":576,"cols":6},{"name":"Small Desktop","px":768,"cols":9},{"name":"Desktop","px":1024,"cols":12}],"order":4,"className":"","visible":"true","disabled":"false"},
  {"id":"simulation-control-group","type":"ui-group","name":"Virtual I/O Simulation","page":"simulation-page","width":12,"height":1,"order":1,"showTitle":false,"className":"","visible":true,"disabled":false,"groupType":"default"},
  {"id":"simulation-control-panel","type":"ui-template","z":"tab-simulation","group":"simulation-control-group","page":"","ui":"","name":"Virtual I/O Simulation Panel","order":1,"width":12,"height":12,"head":"","format":"<template>\n  <div class=\"ms-sim-panel\">\n    <div class=\"ms-sim-toolbar\">\n      <strong>Virtual I/O Simulation</strong>\n      <button @click=\"request('read')\" :disabled=\"!connected\">Refresh</button>\n      <span>{{ connectionText }}</span>\n      <span>API: {{ availabilityText }}</span>\n      <span v-if=\"backend\">Backend: {{ backend }}</span>\n    </div>\n    <div class=\"ms-sim-note\">Mock backend 전용 외부 입력 조작 화면입니다. Command authority는 필요하지 않습니다.</div>\n\n    <fieldset>\n      <legend>Target</legend>\n      <div class=\"ms-form-row\">\n        <label>Station <select v-model=\"selectedIo\" @change=\"syncModule\"><option v-for=\"device in devices\" :key=\"device.id\" :value=\"device.id\">{{ device.id }} (slave {{ device.slave_index }})</option></select></label>\n        <label>Module <select v-model.number=\"selectedSlot\"><option v-for=\"module in modules\" :key=\"module.slot\" :value=\"Number(module.slot)\">Slot {{ module.slot }} · {{ module.type }}</option></select></label>\n        <button @click=\"request('reset_module')\" :disabled=\"!canUse || !selectedModule\">Reset Module</button>\n        <button @click=\"request('reset_station')\" :disabled=\"!canUse || !selectedDevice\">Reset Station</button>\n      </div>\n    </fieldset>\n\n    <fieldset v-if=\"selectedModule && digitalInputs.length\">\n      <legend>Digital Input</legend>\n      <div class=\"ms-form-row\">\n        <label>Channel <select v-model.number=\"digitalChannel\"><option v-for=\"(_,index) in digitalInputs\" :key=\"index\" :value=\"index\">{{ index }}</option></select></label>\n        <label><input type=\"checkbox\" v-model=\"digitalValue\"> ON</label>\n        <button @click=\"request('write_digital')\" :disabled=\"!canUse\">Apply</button>\n        <span>Current: {{ digitalInputs.map((value,index)=>`DI${index}=${value?'ON':'OFF'}`).join(' · ') }}</span>\n      </div>\n    </fieldset>\n\n    <fieldset v-if=\"selectedModule && analogInputs.length\">\n      <legend>Analog Input</legend>\n      <div class=\"ms-form-row\">\n        <label>Channel <select v-model.number=\"analogChannel\"><option v-for=\"(_,index) in analogInputs\" :key=\"index\" :value=\"index\">{{ index }}</option></select></label>\n        <label>Raw Value <input type=\"number\" v-model.number=\"analogValue\"></label>\n        <button @click=\"request('write_analog')\" :disabled=\"!canUse\">Apply</button>\n        <span>Current: {{ analogInputs.map((value,index)=>`AI${index}=${value}`).join(' · ') }}</span>\n      </div>\n    </fieldset>\n\n    <fieldset v-if=\"selectedModule && ioLinkAvailable\">\n      <legend>IO-Link Input Process Data</legend>\n      <div class=\"ms-form-row\">\n        <label>Hex Payload <input class=\"ms-payload\" v-model.trim=\"ioLinkPayload\" placeholder=\"00010203\"></label>\n        <button @click=\"request('write_io_link')\" :disabled=\"!canUse || !ioLinkPayload\">Apply</button>\n        <span>Current: {{ selectedModule.inputs.io_link || '-' }}</span>\n      </div>\n    </fieldset>\n\n    <section class=\"ms-sim-status\">\n      <h3>Virtual Input State</h3>\n      <div v-if=\"!devices.length\">Refresh를 눌러 Virtual I/O 구성을 조회하십시오.</div>\n      <details v-for=\"device in devices\" :key=\"device.id\" open>\n        <summary><strong>{{ device.id }}</strong> · slave {{ device.slave_index }}</summary>\n        <table><thead><tr><th>Module</th><th>Type</th><th>Digital</th><th>Analog</th><th>IO-Link</th></tr></thead><tbody>\n          <tr v-for=\"module in device.modules || []\" :key=\"module.slot\"><td>{{ module.slot }}</td><td>{{ module.type }}</td><td>{{ compact(module.inputs?.digital) }}</td><td>{{ compact(module.inputs?.analog) }}</td><td class=\"ms-mono\">{{ module.inputs?.io_link || '-' }}</td></tr>\n        </tbody></table>\n      </details>\n    </section>\n    <div class=\"ms-result\" :class=\"{failed:lastFailed}\">{{ lastResult }}</div>\n  </div>\n</template>\n<script>\nexport default {\n  data(){return{connected:false,connectionError:'',available:null,backend:'',devices:[],selectedIo:'',selectedSlot:null,digitalChannel:0,digitalValue:false,analogChannel:0,analogValue:0,ioLinkPayload:'',lastResult:'',lastFailed:false}},\n  computed:{\n    selectedDevice(){return this.devices.find(device=>device.id===this.selectedIo)||null},\n    modules(){return this.selectedDevice?.modules||[]},\n    selectedModule(){return this.modules.find(module=>Number(module.slot)===Number(this.selectedSlot))||null},\n    digitalInputs(){return this.selectedModule?.inputs?.digital||[]},\n    analogInputs(){return this.selectedModule?.inputs?.analog||[]},\n    ioLinkAvailable(){return typeof this.selectedModule?.inputs?.io_link==='string'},\n    canUse(){return this.connected&&this.available===true},\n    connectionText(){return this.connected?'Connected':(this.connectionError?`Disconnected: ${this.connectionError}`:'Disconnected')},\n    availabilityText(){if(this.available===true)return 'available';if(this.available===false)return 'not available';return 'not checked'}\n  },\n  watch:{\n    msg:{deep:true,immediate:true,handler(message){if(!message||!message.topic)return;const value=message.payload||{};if(message.topic==='simulation/connection'){this.connected=value.connected===true;this.connectionError=value.last_error||'';if(!this.connected){this.available=null;this.backend='';this.devices=[]}}else if(message.topic==='simulation/response'){this.handleResponse(value)}}},\n    selectedSlot(){this.syncInputEditors()}\n  },\n  methods:{\n    compact(value){return Array.isArray(value)?JSON.stringify(value):'-'},\n    request(action){this.send({payload:{action,io:this.selectedIo,slot:this.selectedSlot,digital_channel:this.digitalChannel,digital_value:this.digitalValue,analog_channel:this.analogChannel,analog_value:this.analogValue,io_link_payload:this.ioLinkPayload}})},\n    updateDevices(devices){this.devices=Array.isArray(devices)?devices:[];if(!this.devices.some(device=>device.id===this.selectedIo))this.selectedIo=this.devices[0]?.id||'';this.syncModule()},\n    syncModule(){this.$nextTick(()=>{if(!this.modules.some(module=>Number(module.slot)===Number(this.selectedSlot)))this.selectedSlot=this.modules[0]?.slot??null;this.syncInputEditors()})},\n    syncInputEditors(){this.$nextTick(()=>{if(this.digitalChannel>=this.digitalInputs.length)this.digitalChannel=0;if(this.analogChannel>=this.analogInputs.length)this.analogChannel=0;if(this.selectedModule){this.digitalValue=Boolean(this.digitalInputs[this.digitalChannel]??false);this.analogValue=Number(this.analogInputs[this.analogChannel]??0);this.ioLinkPayload=this.selectedModule.inputs?.io_link||''}})},\n    handleResponse(response){if(response.ok){const data=response.data||{};this.available=data.available===true;this.backend=data.backend||'';this.updateDevices(data.devices||[]);this.lastResult=`${response.type}: SUCCESS`;this.lastFailed=false}else{const failure=response.failure||{};if(failure.code==='UNSUPPORTED_OPERATION')this.available=false;this.lastResult=`FAIL: ${failure.code||failure.message||'CLIENT_ERROR'}${failure.message?` · ${failure.message}`:''}`;this.lastFailed=true}}\n  }\n}\n</script>\n<style>\n.ms-sim-panel{font-family:Arial,sans-serif;color:#222}.ms-sim-toolbar,.ms-form-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.ms-sim-toolbar strong{font-size:20px;margin-right:8px}.ms-sim-note{margin:8px 0;padding:7px 9px;background:#eef5ff;border-left:4px solid #3478c7}.ms-sim-panel fieldset,.ms-sim-status{border:1px solid #ccc;padding:10px;margin:9px 0}.ms-sim-panel legend{padding:0 5px}.ms-sim-panel button{border:1px solid #aaa;border-radius:4px;background:#fff;padding:6px 10px;cursor:pointer}.ms-sim-panel button:disabled{color:#999;background:#eee;cursor:default}.ms-sim-panel input,.ms-sim-panel select{border:1px solid #bbb;background:#fff;padding:5px;max-width:210px}.ms-sim-panel input.ms-payload{width:360px;max-width:70vw;font-family:monospace}.ms-form-row label{display:flex;align-items:center;gap:5px;white-space:nowrap}.ms-sim-status h3{margin:0 0 8px}.ms-sim-status table{width:100%;border-collapse:collapse;margin:8px 0}.ms-sim-status th,.ms-sim-status td{border:1px solid #ddd;padding:6px;text-align:left}.ms-mono{font-family:monospace;word-break:break-all}.ms-result{margin-top:8px;color:#176d29}.ms-result.failed{color:#b3261e}@media(max-width:800px){.ms-form-row label{flex:1 1 45%}.ms-sim-toolbar>*{flex:1 1 auto}.ms-sim-toolbar strong{flex-basis:100%}}\n</style>","storeOutMessages":true,"passthru":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":990,"y":260,"wires":[["build-simulation-request"]]},
  {"id":"simulation-feedback","type":"motion-server-feedback","z":"tab-simulation","name":"Connection Feedback","connection":"cfg-status","x":170,"y":100,"wires":[["format-simulation-feedback"]]},
  {"id":"format-simulation-feedback","type":"function","z":"tab-simulation","name":"Feedback Means Connected","func":"return {topic:'simulation/connection',payload:{connected:true,last_error:''}};","outputs":1,"x":450,"y":100,"wires":[["simulation-control-panel"]]},
  {"id":"simulation-connection-status","type":"motion-server-connection-status","z":"tab-simulation","name":"Connection Status","connection":"cfg-status","x":170,"y":160,"wires":[["format-simulation-connection"]]},
  {"id":"format-simulation-connection","type":"function","z":"tab-simulation","name":"Format Connection Status","func":"const status=msg.payload||{};return {topic:'simulation/connection',payload:{connected:status.connected===true,last_error:status.last_error||''}};","outputs":1,"x":450,"y":160,"wires":[["simulation-control-panel"]]},
  {"id":"build-simulation-request","type":"function","z":"tab-simulation","name":"Build Simulation Request","func":"const value=msg.payload||{};let payload;if(value.action==='read'){payload={cmd:'system/simulation/io/input_read'};}else if(value.action==='write_digital'){payload={cmd:'system/simulation/io/input_write',io:value.io,slot:Number(value.slot),kind:'digital',channel:Number(value.digital_channel),value:value.digital_value===true};}else if(value.action==='write_analog'){payload={cmd:'system/simulation/io/input_write',io:value.io,slot:Number(value.slot),kind:'analog',channel:Number(value.analog_channel),value:Number(value.analog_value)};}else if(value.action==='write_io_link'){payload={cmd:'system/simulation/io/input_write',io:value.io,slot:Number(value.slot),kind:'io_link',payload:String(value.io_link_payload||'').trim()};}else if(value.action==='reset_module'){payload={cmd:'system/simulation/io/input_reset',io:value.io,slot:Number(value.slot)};}else if(value.action==='reset_station'){payload={cmd:'system/simulation/io/input_reset',io:value.io};}else{return null;}return {payload};","outputs":1,"x":300,"y":270,"wires":[["simulation-request"]]},
  {"id":"simulation-request","type":"motion-server-request","z":"tab-simulation","name":"Simulation API","connection":"cfg-status","timeout":"","x":560,"y":270,"wires":[["format-simulation-response"],["format-simulation-response"]]},
  {"id":"format-simulation-response","type":"function","z":"tab-simulation","name":"Format Simulation Response","func":"const response=msg.payload||{};if(response.result==='success')return {topic:'simulation/response',payload:{ok:true,type:response.type||'',data:response.data||{}}};const failure=response.failure||{code:response.code||'CLIENT_ERROR',message:response.message||''};return {topic:'simulation/response',payload:{ok:false,type:response.type||'',failure}};","outputs":1,"x":820,"y":270,"wires":[["simulation-control-panel","simulation-response-debug"]]},
  {"id":"simulation-response-debug","type":"debug","z":"tab-simulation","name":"Simulation Result","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":1080,"y":340,"wires":[]}
]
