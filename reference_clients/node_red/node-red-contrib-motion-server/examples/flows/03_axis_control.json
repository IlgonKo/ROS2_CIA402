  {"id":"axis-feedback","type":"motion-server-feedback","z":"tab-axis","name":"System Feedback","connection":"cfg-status","x":150,"y":120,"wires":[["axis-position-series","axis-velocity-series"]]},
  {"id":"axis-position-series","type":"function","z":"tab-axis","name":"Position Series","func":"const values = Array.isArray(msg.payload.actual_positions) ? msg.payload.actual_positions : [];\nlet count = flow.get('axisCount');\nif (!Number.isInteger(count)) { count = values.length; flow.set('axisCount', count); }\nconst names = flow.get('axisNames') || [];\nreturn [values.slice(0, count).map((value, index) => ({ topic: names[index] || `Axis ${index}`, payload: Number(value) }))];","outputs":1,"x":460,"y":100,"wires":[["axis-position-chart"]]},
  {"id":"axis-velocity-series","type":"function","z":"tab-axis","name":"Velocity Series","func":"const values = Array.isArray(msg.payload.actual_velocities) ? msg.payload.actual_velocities : [];\nlet count = flow.get('axisCount');\nif (!Number.isInteger(count)) { count = values.length; flow.set('axisCount', count); }\nconst names = flow.get('axisNames') || [];\nreturn [values.slice(0, count).map((value, index) => ({ topic: names[index] || `Axis ${index}`, payload: Number(value) }))];","outputs":1,"x":460,"y":160,"wires":[["axis-velocity-chart"]]},
  {"id":"axis-connection","type":"motion-server-connection-status","z":"tab-axis","name":"Connection Status","connection":"cfg-status","x":160,"y":60,"wires":[["axis-clear-charts"]]},
  {"id":"axis-clear-charts","type":"function","z":"tab-axis","name":"Clear on Disconnect","func":"if (msg.payload.connected) return null;\nflow.set('axisCount', null);\nflow.set('axisNames', []);\nreturn { payload: [] };","outputs":1,"x":470,"y":60,"wires":[["axis-position-chart","axis-velocity-chart"]]},
  {"id":"inject-axis-status","type":"inject","z":"tab-axis","name":"Refresh Axis Status/Names","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axes/status\"}","payloadType":"json","once":false,"x":180,"y":240,"wires":[["axis-request"]]},
  {"id":"inject-axis-enable","type":"inject","z":"tab-axis","name":"Enable Axis 0","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axis/enable\",\"axis\":0}","payloadType":"json","once":false,"x":150,"y":290,"wires":[["axis-request"]]},
  {"id":"inject-axis-disable","type":"inject","z":"tab-axis","name":"Disable Axis 0","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axis/disable\",\"axis\":0}","payloadType":"json","once":false,"x":150,"y":340,"wires":[["axis-request"]]},
  {"id":"inject-axis-absolute","type":"inject","z":"tab-axis","name":"Move Axis 0 Absolute 10","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axis/move_abs\",\"axis\":0,\"position\":10.0}","payloadType":"json","once":false,"x":180,"y":390,"wires":[["axis-request"]]},
  {"id":"inject-axis-relative","type":"inject","z":"tab-axis","name":"Move Axis 0 Relative 1","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axis/move_rel\",\"axis\":0,\"distance\":1.0}","payloadType":"json","once":false,"x":170,"y":440,"wires":[["axis-request"]]},
  {"id":"inject-axis-stop","type":"inject","z":"tab-axis","name":"Stop Axis 0","props":[{"p":"payload"}],"payload":"{\"cmd\":\"system/axis/stop\",\"axis\":0}","payloadType":"json","once":false,"x":140,"y":490,"wires":[["axis-request"]]},
  {"id":"axis-request","type":"motion-server-request","z":"tab-axis","name":"Axis API","connection":"cfg-status","timeout":"","x":440,"y":340,"wires":[["axis-store-names","axis-response"],["axis-client-error"]]},
  {"id":"axis-store-names","type":"function","z":"tab-axis","name":"Store Axis Names","func":"if (msg.payload.type !== 'system/axes/status') return null;\nconst data = msg.payload.data || msg.payload;\nconst metadata = Array.isArray(data.axis_metadata) ? data.axis_metadata : [];\nconst count = Array.isArray(data.actual_positions) ? data.actual_positions.length : metadata.length;\nflow.set('axisNames', Array.from({length: count}, (_, i) => metadata[i] && metadata[i].name ? metadata[i].name : `Axis ${i}`));\nreturn null;","outputs":1,"x":680,"y":300,"wires":[[]]},
  {"id":"axis-response","type":"debug","z":"tab-axis","name":"Axis Success or Fail","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":700,"y":360,"wires":[]},
  {"id":"axis-client-error","type":"debug","z":"tab-axis","name":"Axis Client Error","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","x":690,"y":410,"wires":[]}
