# Motion Server backend.
# Real EtherCAT device: pysoem
# Virtual mock axes: mock
MOTION_SERVER_BACKEND=pysoem

# Motion Server feature mode.
# basic: profile/point motion and parameter APIs
# advanced: enables cyclic trajectory commands
MOTION_SERVER_MODE=basic

# EtherCAT NIC name.
# Used only when MOTION_SERVER_BACKEND=pysoem.
PYSOEM_INTERFACE=enp1s0

# Mock virtual servo drive settings are stored separately.
# Copy device/virtual_servo_drive/.env.example to device/virtual_servo_drive/.env
# when MOTION_SERVER_BACKEND=mock.

# EtherCAT bus layout in physical slave order.
# Entries without a prefix are motion axes.
# Use io:<profile> or device:<profile> for non-motion slaves.
# Example with CMMT axes on slave 0 and 1, and CPX I/O on slave 2:
# PYSOEM_BUS=cmmt,cmmt,io:cpx_ap_i_ec
PYSOEM_BUS=cmmt

# Copy device/<profile>/.env.example to device/<profile>/.env when needed.
# Motion Server loads PYSOEM_DEVICE_CONFIG_ROOT/<profile>/.env for profiles
# used in PYSOEM_BUS.
PYSOEM_DEVICE_CONFIG_ROOT=device

# TCP port used by Motion Server, Axis Panel, and ROS Bridge.
MOTION_SERVER_PORT=15000

# Motion Server TCP host used by ROS Bridge.
# Windows ROS container -> Ubuntu Motion Server: 192.168.0.12
# Same-host ROS container -> local Motion Server: 127.0.0.1
MOTION_SERVER_HOST=192.168.0.12

# ROS Bridge automatically requests Motion Server command authority after TCP
# connection. Set to 0 if another client should hold authority explicitly.
ROS_BRIDGE_AUTO_REQUEST_AUTHORITY=1

# FollowJointTrajectory action completion settings used by ROS Bridge.
# Units follow the joint position units used by /joint_trajectory.
# Set result timeout to 0.0 to wait until all axes reach target or goal is canceled.
ROS_BRIDGE_ACTION_GOAL_TOLERANCE=0.01
ROS_BRIDGE_ACTION_RESULT_TIMEOUT=0.0

# Motion Server process-data cycle time in seconds.
PYSOEM_CYCLE_TIME=0.01

# Motion Server TCP system/feedback period in seconds.
MOTION_SERVER_FEEDBACK_PERIOD=0.05

# Busy-wait window before each EtherCAT cycle deadline in seconds.
# Larger values can reduce wake-up jitter at the cost of CPU usage.
PYSOEM_SPIN_WAIT_TIME=0.00015

# Optional CPU affinity for the Motion Server process.
# Empty uses all CPUs. Example: 6 or 6,7.
MOTION_SERVER_CPUSET=

# Optional host-level CPU isolation settings applied by
# scripts/host/isolate_cpu.sh. Empty isolated CPUs falls back to
# MOTION_SERVER_CPUSET. Reboot is required after install/revert.
MOTION_SERVER_ISOLATED_CPUS=
MOTION_SERVER_HOUSEKEEPING_CPUS=

# EtherCAT distributed clocks.
PYSOEM_DC_ENABLED=0
PYSOEM_DC_SYNC0_SHIFT_TIME_NS=0

# Optional phase lock of the master PDO send time to EtherCAT DC Sync0.
# PYSOEM_DC_PHASE_LOCK=0 disables master send phase compensation.
# When phase lock is enabled, PYSOEM_DC_ABSOLUTE_SHIFT=1 schedules sends
# directly from the current DC phase; 0 uses PI correction.
PYSOEM_DC_PHASE_LOCK=0
PYSOEM_DC_ABSOLUTE_SHIFT=0
PYSOEM_DC_PHASE_OFFSET_NS=800000
PYSOEM_DC_PHASE_KP=0.02
PYSOEM_DC_PHASE_KI=0.00001
PYSOEM_DC_PHASE_MAX_CORRECTION=0.00005

# Motion Server status log period in seconds. Set 0.0 to disable status logs.
PYSOEM_STATUS_LOG_PERIOD=1.0

# Motion Server EtherCAT cycle statistics logs.
PYSOEM_CYCLE_STATS_LOGS=1

# Motion Server EtherCAT cycle statistics log period in seconds.
PYSOEM_CYCLE_STATS_PERIOD=1.0

# Logs ROS Bridge trajectory command receive/segment-extension summaries.
ROS_BRIDGE_COMMAND_LOGS=0

# Logs raw JSON commands received by Motion Server.
MOTION_SERVER_COMMAND_LOGS=0

# Logs Motion Server state changes such as client connect/disconnect, command
# authority changes, homing, mode changes, enable/disable, stop, and reset.
MOTION_SERVER_STATUS_LOGS=0

# Trajectory start/complete snapshots for comparing noisy and quiet runs.
PYSOEM_TRAJECTORY_SNAPSHOT_LOGS=0
PYSOEM_TRAJECTORY_DEBUG_LOGS=0

# Extra anomaly logs. Keep disabled unless investigating command steps or
# actual velocity spikes specifically.
PYSOEM_CSP_COMMAND_STEP_LOGS=0
PYSOEM_CSP_COMMAND_STEP_THRESHOLD=0.0
PYSOEM_CSP_COMMAND_STEP_ERROR_THRESHOLD=0.0

# Low-pass filter alpha for derived velocity display.
# 1.0 disables filtering.
PYSOEM_DERIVED_VELOCITY_ALPHA=0.2

# CSP profile for Point Move and position-only Trajectory Move:
# trapezoid or quintic.
PYSOEM_CSP_PROFILE=quintic

# Logs a velocity anomaly when actual-command velocity error or actual velocity
# jump exceeds the threshold in mm/s.
PYSOEM_VELOCITY_ANOMALY_LOGS=0
PYSOEM_VELOCITY_ANOMALY_THRESHOLD=15.0
PYSOEM_VELOCITY_JUMP_THRESHOLD=15.0
PYSOEM_VELOCITY_ANOMALY_LOG_PERIOD=0.05
PYSOEM_POSITION_FEEDBACK_LAG_LOGS=0
PYSOEM_POSITION_FEEDBACK_LAG_LOG_PERIOD=0.2

# Docker Compose project name.
COMPOSE_PROJECT_NAME=ros2_cia402_pysoem
