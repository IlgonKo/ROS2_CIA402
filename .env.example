# Axis Server backend.
# Real EtherCAT device: pysoem
# Virtual mock axes: mock
AXIS_SERVER_BACKEND=pysoem

# EtherCAT NIC name.
# Used only when AXIS_SERVER_BACKEND=pysoem.
PYSOEM_INTERFACE=enp1s0

# Number of axes.
# mock: number of virtual axes
# pysoem: number of connected EtherCAT slaves
PYSOEM_AXIS_COUNT=1

# TCP port used by Axis Server, Axis Panel, and ROS Bridge.
PYSOEM_AXIS_SERVER_PORT=15000

# Axis Server TCP host used by ROS Bridge.
# Windows ROS container -> Ubuntu Axis Server: 192.168.0.12
# Same-host ROS container -> local Axis Server: 127.0.0.1
CIA402_AXIS_SERVER_HOST=192.168.0.12

# ROS Bridge automatically requests Axis Server command authority after TCP
# connection. Set to 0 if another client should hold authority explicitly.
CIA402_AUTO_REQUEST_AUTHORITY=1

# FollowJointTrajectory action completion settings used by ROS Bridge.
# Units follow the joint position units used by /joint_trajectory.
# Set result timeout to 0.0 to wait until all axes reach target or goal is canceled.
CIA402_ACTION_GOAL_TOLERANCE=0.01
CIA402_ACTION_RESULT_TIMEOUT=0.0

# Axis Server process-data cycle time in seconds.
PYSOEM_CYCLE_TIME=0.01

# Busy-wait window before each EtherCAT cycle deadline in seconds.
# Larger values can reduce wake-up jitter at the cost of CPU usage.
PYSOEM_SPIN_WAIT_TIME=0.00015

# Optional CPU affinity for the Axis Server process.
# Empty uses all CPUs. Example: 6 or 6,7.
PYSOEM_AXIS_SERVER_CPUSET=

# Optional host-level CPU isolation settings applied by
# scripts/host/isolate_cpu.sh. Empty isolated CPUs falls back to
# PYSOEM_AXIS_SERVER_CPUSET. Reboot is required after install/revert.
PYSOEM_HOST_ISOLATED_CPUS=
PYSOEM_HOST_HOUSEKEEPING_CPUS=

# CMMT EtherCAT sync setup written via vendor object 0x212E before OP.
# 0=FreeRun, 1=sync with process data, 2=DC Sync0.
# The sync cycle time follows PYSOEM_CYCLE_TIME.
PYSOEM_SYNC_MODE=0

# EtherCAT distributed clocks. Set PYSOEM_SYNC_MODE=2 when enabling DC Sync0.
PYSOEM_DC_ENABLED=0
PYSOEM_DC_SYNC0_SHIFT_TIME_NS=0

# Optional PI phase lock of the master send time to EtherCAT DC Sync0.
# Target sends PDO before Sync0 by PYSOEM_DC_SEND_OFFSET_NS.
PYSOEM_DC_PHASE_LOCK=0
PYSOEM_DC_ABSOLUTE_SCHEDULE=0
PYSOEM_DC_SEND_OFFSET_NS=800000
PYSOEM_DC_PHASE_KP=0.02
PYSOEM_DC_PHASE_KI=0.00001
PYSOEM_DC_PHASE_MAX_CORRECTION=0.00005

# Initial Axis Server motion limits.
PYSOEM_MAX_VELOCITY=50.0
PYSOEM_ACCELERATION=50.0
PYSOEM_DECELERATION=50.0
PYSOEM_JERK=100000.0
PYSOEM_PP_JERK=100000

# Axis Server status log period in seconds. Set 0.0 to disable status logs.
PYSOEM_STATUS_LOG_PERIOD=1.0

# Axis Server EtherCAT cycle statistics log period in seconds.
PYSOEM_CYCLE_STATS_PERIOD=1.0

# CSP velocity scaling.
# Example: 1000 count/mm means panel velocity 1000 becomes 1000000 count/s.
PYSOEM_CSP_COUNTS_PER_UNIT=1000.0
PYSOEM_CSP_INTERPOLATION_MODE=1
PYSOEM_CSP_VELOCITY_OFFSET=0

# Trajectory start/complete snapshots for comparing noisy and quiet runs.
PYSOEM_TRAJECTORY_SNAPSHOT_LOGS=0
PYSOEM_TRAJECTORY_DEBUG_LOGS=0

# Extra anomaly logs. Keep disabled unless investigating command steps or
# actual velocity spikes specifically.
PYSOEM_CSP_COMMAND_STEP_LOGS=0
PYSOEM_CSP_COMMAND_STEP_THRESHOLD=0.0
PYSOEM_CSP_COMMAND_STEP_ERROR_THRESHOLD=0.0

# TxPDO setpoint feedback experiments.
# Default restore keeps the CMMT TxPDO1 layout at factory-compatible feedback.
# Supported feedback objects: 6062, 217A01, 6062_REPLACE_6064, 6062_REPLACE_606C.
# Enable PYSOEM_TXPDO_SETPOINT_FEEDBACK only after the selected object is validly
# mapped by a commissioning tool. Runtime remap is experimental and may fail SAFE_OP.
PYSOEM_RESTORE_DEFAULT_TXPDO_MAPPING=1
PYSOEM_TXPDO_SETPOINT_FEEDBACK=0
PYSOEM_CONFIGURE_TXPDO_SETPOINT_FEEDBACK=0
PYSOEM_TXPDO_SETPOINT_FEEDBACK_OBJECT=6062

# Low-pass filter alpha for derived velocity display.
# 1.0 disables filtering.
PYSOEM_DERIVED_VELOCITY_ALPHA=0.2

# Logs a velocity anomaly when actual-command velocity error or actual velocity
# jump exceeds the threshold in mm/s.
PYSOEM_VELOCITY_ANOMALY_LOGS=0
PYSOEM_VELOCITY_ANOMALY_THRESHOLD=15.0
PYSOEM_VELOCITY_JUMP_THRESHOLD=15.0
PYSOEM_VELOCITY_ANOMALY_LOG_PERIOD=0.05
PYSOEM_POSITION_FEEDBACK_LAG_LOGS=0
PYSOEM_POSITION_FEEDBACK_LAG_LOG_PERIOD=0.2

# Initial motion mode.
# pp is recommended for normal non-real-time host operation.
# csp is available for cyclic position streaming tests.
PYSOEM_MOTION_MODE=pp

# Docker Compose project name.
COMPOSE_PROJECT_NAME=ros2_cia402_pysoem
